<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinRunner.Gui.ViewModels"
        x:Class="WinRunner.Gui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WinRunner — Windows App Runner"
        Width="920"
        Height="620"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="16">

        <!-- Top status bar -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="12"
                Background="{DynamicResource SystemChromeLowColor}"
                CornerRadius="6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="WinRunner" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="{Binding WineStatus}" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemAccentColor}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main content: left list, right install form -->
        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">

            <!-- Left: installed apps list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Installed Apps" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10" CornerRadius="6"
                        Background="{DynamicResource SystemChromeLowColor}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                </Border>
                <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppItemViewModel">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding Architecture}" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="{Binding LastLaunched}" FontSize="11" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: actions -->
            <StackPanel Grid.Column="1" Spacing="12">

                <!-- Launch / uninstall / set exe -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Launch" Command="{Binding LaunchCommand}" IsEnabled="{Binding SelectedApp}"/>
                    <Button Content="Set Executable" Command="{Binding SetExecutableCommand}" IsEnabled="{Binding SelectedApp}"/>
                    <Button Content="Uninstall" Command="{Binding UninstallCommand}" IsEnabled="{Binding SelectedApp}"/>
                </StackPanel>

                <!-- Install form -->
                <Border Padding="14" CornerRadius="6" Background="{DynamicResource SystemChromeLowColor}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Install a Windows application" FontWeight="SemiBold" FontSize="15"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="App name"/>
                            <TextBox Text="{Binding InstallName}" Watermark="e.g. 7-Zip"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Installer file (.exe or .msi)"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding InstallerPath}" Watermark="/path/to/setup.exe"/>
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseInstallerCommand}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Main executable (optional, relative to drive_c)"/>
                            <TextBox Text="{Binding ExecutablePath}" Watermark="e.g. C:\Program Files\App\app.exe"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Architecture"/>
                            <ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding Architecture}"/>
                        </StackPanel>

                        <Button Content="Install" Command="{Binding InstallCommand}"
                                HorizontalAlignment="Stretch" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
