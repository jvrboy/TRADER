<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:TraderUI.Views"
       x:Class="TraderUI.AppShell"
       Shell.NavBarIsVisible="False"
       FlyoutBehavior="Disabled"
       Shell.TabBarBackgroundColor="#0F1624"
       Shell.TabBarTitleColor="#00D4FF"
       Shell.TabBarUnselectedColor="#4A5568">

    <TabBar>
        <!-- AI Chat Tab -->
        <ShellContent
            Title="AI Chat"
            ContentTemplate="{DataTemplate views:AiChatPage}"
            Route="AiChatPage" />

        <!-- Quotes Tab -->
        <ShellContent
            Title="Quotes"
            ContentTemplate="{DataTemplate views:QuotesPage}"
            Route="QuotesPage" />

        <!-- Chart Tab -->
        <ShellContent
            Title="Chart"
            ContentTemplate="{DataTemplate views:ChartPage}"
            Route="ChartPage" />

        <!-- Signals Tab -->
        <ShellContent
            Title="Signals"
            ContentTemplate="{DataTemplate views:SignalsPage}"
            Route="SignalsPage" />

        <!-- Bot Tab -->
        <ShellContent
            Title="Bot"
            ContentTemplate="{DataTemplate views:BotPage}"
            Route="BotPage" />
    </TabBar>

</Shell>
