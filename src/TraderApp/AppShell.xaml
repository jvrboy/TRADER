<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:TraderUI.Views"
       x:Class="TraderUI.AppShell"
       Shell.NavBarIsVisible="False"
       FlyoutBehavior="Disabled">

    <TabBar>
        <!-- AI Chat Tab -->
        <ShellContent
            Title="AI Chat"
            Icon="icon_chat.png"
            ContentTemplate="{DataTemplate views:AiChatPage}"
            Route="AiChatPage" />

        <!-- Quotes Tab -->
        <ShellContent
            Title="Quotes"
            Icon="icon_quotes.png"
            ContentTemplate="{DataTemplate views:QuotesPage}"
            Route="QuotesPage" />

        <!-- Chart Tab -->
        <ShellContent
            Title="Chart"
            Icon="icon_chart.png"
            ContentTemplate="{DataTemplate views:ChartPage}"
            Route="ChartPage" />

        <!-- Signals Tab -->
        <ShellContent
            Title="Signals"
            Icon="icon_signals.png"
            ContentTemplate="{DataTemplate views:SignalsPage}"
            Route="SignalsPage" />

        <!-- Bot Tab -->
        <ShellContent
            Title="Bot"
            Icon="icon_bot.png"
            ContentTemplate="{DataTemplate views:BotPage}"
            Route="BotPage" />
    </TabBar>

</Shell>
